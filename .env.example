# Optional API keys. The server works fully without these; each key unlocks
# additional / higher-rate sources. Never commit real keys.

# GitHub token -> higher rate limit for github_* tools
GITHUB_TOKEN=

# HaveIBeenPwned API key -> breachedaccount lookups (free ~$4.50/mo)
HIBP_API_KEY=

# AlienVault OTX API key -> OTX threat pulses (free)
OTX_API_KEY=

# Shodan API key -> shodan_* tools (free tier available)
SHODAN_API_KEY=

# VirusTotal API key -> virustotal domain/IP/URL reputation (free tier)
VIRUSTOTAL_API_KEY=

# Hunter.io API key -> discover/find emails on a domain
HUNTER_API_KEY=
